  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "test": "tsx --env-file-if-exists=.env --test --test-concurrency=2 tests/*.test.ts",
    "check": "tsc --noEmit",
    "services:up": "docker compose up -d postgres spicedb mailpit && pnpm services:wait",
    "services:stop": "docker compose stop postgres spicedb mailpit",
    "services:logs": "docker compose logs --tail=100 postgres spicedb spicedb-migrate",
    "services:wait": "node --env-file-if-exists=.env --import tsx scripts/wait-services.ts",
    "fixture": "node --env-file-if-exists=.env --import tsx scripts/browser-fixture.ts",
    "setup:local": "node --import tsx scripts/setup-local.ts",
    "worker": "NODE_ENV=production tsx --env-file-if-exists=.env server/worker.ts",
    "storage:migrate": "tsx --env-file-if-exists=.env server/migrate-storage.ts",
    "dev:worker": "tsx --env-file-if-exists=.env server/worker.ts"
  },
